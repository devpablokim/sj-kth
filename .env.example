# ─────────────────────────────────────────────────────────────
# Vercel AI Gateway
#   발급: vercel ai-gateway api-keys create --name my-api-key
#   (Vercel 대시보드 → AI Gateway → API Keys 에서도 발급 가능)
# ─────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=

# 분석(판정) 모델 — jev. Gateway 모델 ID 그대로 사용
JEV_MODEL=typesafe-ai/jev

# 시안(초안) 생성용 텍스트 모델 (선택). 비우면 기본값 사용
# 예: anthropic/claude-sonnet-4.5, openai/gpt-5, google/gemini-2.5-flash
DRAFT_MODEL=

# 키 없이 UI만 확인하고 싶을 때 1 로 설정 (가짜 판정값으로 동작)
JEV_DEMO_MODE=

# 비용 표시: USD → KRW 환산 환율 (표시용 추정)
KRW_PER_USD=1400
# jev 단가 덮어쓰기 (USD per 1M tokens). 비우면 gateway 가격표 → 없으면 실측 추정치($0.04/1M) 사용
JEV_PRICE_INPUT_PER_M=
JEV_PRICE_OUTPUT_PER_M=

# ── 무료 수집기는 키가 전혀 필요 없습니다 (YouTube 검색 페이지 · Threads(Jina Reader) · X(fxtwitter) · Instagram(og 태그)) ──
# (선택) Jina Reader 키 — 없으면 익명 한도(분당 20회). https://jina.ai 에서 무료 발급
JINA_API_KEY=
# (선택) YouTube Data API v3 키 — 있으면 YouTube 검색에 정확한 좋아요·길이를 씀, 없으면 검색 페이지 파싱
YOUTUBE_API_KEY=

# (선택) 1 이면 모든 jev 호출에 gateway zeroDataRetention 옵션을 붙임 (Zero Data Retention)
JEV_ZERO_DATA_RETENTION=
